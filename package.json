{
  "name": "playwright-element-handling-framework",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted Playwright framework for Selenium Playground element handling",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test \"eslint-rules/tests/*.test.mjs\" \"scripts/*.test.mjs\"",
    "validate:cases": "node scripts/validate-test-cases.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:rules && npm run validate:cases",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
